# KiCad temporary and generated files
# https://github.com/github/gitignore/blob/main/KiCad.gitignore

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
*-cache*
*-bak*
*~
~*
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck

# Local git-based history (KiCad 9.0+)
.history/

# Local project settings
*.kicad_prl

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml

# Redundant gerber archives (the gerbers/ folders are tracked instead)
gerbers.zip

# Local design notes, not published
docs/
